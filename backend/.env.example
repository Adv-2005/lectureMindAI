# Local Ollama model settings
LECTUREMIND_OLLAMA_BASE_URL=http://localhost:11434
LECTUREMIND_CHAT_MODEL=qwen2.5:1.5b
LECTUREMIND_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Retrieval and chunking settings
LECTUREMIND_RETRIEVAL_K=5
LECTUREMIND_CHUNK_SIZE=1000
LECTUREMIND_CHUNK_OVERLAP=200
LECTUREMIND_MAX_HISTORY_MESSAGES=10

# Optional absolute or backend-relative paths
# LECTUREMIND_CHROMA_PATH=chroma_db
# LECTUREMIND_UPLOADS_DIR=uploads
# LECTUREMIND_CHECKPOINT_DB_PATH=langgraph_checkpoints.sqlite
